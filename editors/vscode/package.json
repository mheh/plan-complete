{
  "name": "plan-complete",
  "displayName": "Plan Complete",
  "description": "Plan-guided inline completion from a local fill-in-the-middle model",
  "version": "0.1.0",
  "publisher": "plan-complete",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "local"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Plan Complete",
      "properties": {
        "planComplete.serverPath": {
          "type": "string",
          "default": "plan-complete",
          "description": "Path of the plan-complete binary."
        },
        "planComplete.settings": {
          "type": "object",
          "default": {},
          "description": "Overrides of .plan-complete.json, for example { \"model\": \"qwen2.5-coder\" }."
        },
        "planComplete.passSignatureHelp": {
          "type": "boolean",
          "default": true,
          "description": "Send signature help from the real language server as context."
        }
      }
    },
    "commands": [
      {
        "command": "planComplete.restart",
        "title": "Plan Complete: Restart Server"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
