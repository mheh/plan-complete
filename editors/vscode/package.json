{
  "name": "plan-complete",
  "displayName": "Plan Complete",
  "description": "Plan-guided inline completion from a local fill-in-the-middle model",
  "version": "0.2.0",
  "publisher": "plan-complete",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mheh/plan-complete.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Plan Complete",
      "properties": {
        "planComplete.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Full path of the `plan-complete` binary. Empty: the binary inside the extension, then `plan-complete` on `PATH`."
        },
        "planComplete.settings": {
          "$ref": "plan-complete-settings",
          "type": "object",
          "default": {},
          "markdownDescription": "Overrides of the server settings (the global file, then `.plan-complete.json`) for VS Code only, for example `{ \"model\": \"qwen2.5-coder\" }`. `guide` is ignored here."
        }
      }
    },
    "commands": [
      {
        "command": "planComplete.enable",
        "title": "Enable in This Workspace",
        "category": "Plan Complete"
      },
      {
        "command": "planComplete.toggle",
        "title": "Toggle for This Workspace",
        "category": "Plan Complete"
      },
      {
        "command": "planComplete.openPlan",
        "title": "Open the Plan",
        "category": "Plan Complete"
      },
      {
        "command": "planComplete.openSettings",
        "title": "Open the Repository Settings",
        "category": "Plan Complete"
      },
      {
        "command": "planComplete.openGlobalSettings",
        "title": "Open the Global Settings",
        "category": "Plan Complete"
      },
      {
        "command": "planComplete.restart",
        "title": "Restart Server",
        "category": "Plan Complete"
      },
      {
        "command": "planComplete.menu",
        "title": "Show Options",
        "category": "Plan Complete"
      }
    ],
    "languages": [
      {
        "id": "jsonc",
        "filenames": [
          ".plan-complete.json"
        ],
        "filenamePatterns": [
          "**/plan-complete/config.json"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          ".plan-complete.json",
          "**/plan-complete/config.json"
        ],
        "url": "./schemas/plan-complete.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
